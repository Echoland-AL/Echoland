http://app.anyland.com {
    reverse_proxy localhost:8000
}

http://d6ccx151yatz6.cloudfront.net {
    reverse_proxy localhost:8001
}

http://d26e4xubm8adxu.cloudfront.net {
    reverse_proxy localhost:8002
