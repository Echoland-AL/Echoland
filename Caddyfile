http://steamuserimages-a.akamaihd.net {
    reverse_proxy https://images.steamusercontent.com {
        header_up Host images.steamusercontent.com
    }
}

# PORT 80 PATH ROUTER FOR DIRECT IP CONNECTIONS
:80 {
    # Area Bundles CDN -> Echoland Port 8002
    handle_path /cdn-bundles* {
        reverse_proxy localhost:8002
    }

    # Thing Definitions CDN -> Echoland Port 8001
    handle_path /cdn-things* {
        reverse_proxy localhost:8001
    }

    # Steam User Images CDN -> Steam
    handle_path /cdn-steam* {
        reverse_proxy https://images.steamusercontent.com {
            header_up Host images.steamusercontent.com
        }
    }

    # Synth audio route
    route /synth* {
        reverse_proxy localhost:42069
    }

    # Default API Route -> Echoland Port 8000
    reverse_proxy localhost:8000
}
